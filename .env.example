# Kelta Local Development Environment Variables
# ─────────────────────────────────────────────
# 1. Copy this file: cp .env.example .env
# 2. Generate dev keys: make gen-keys
#    (appends JWK_SET, KELTA_ENCRYPTION_KEY and the HMAC signing keys to .env)
# 3. Start the stack: docker compose up -d   (pulls the release below)
#    or, from source:   make up-jvm            (builds this checkout)
#
# Secrets below are DEV-ONLY. Never use these values in any deployed environment.

# Kelta release `docker compose up` pulls from ghcr.io/kelta-io (auth, worker, gateway, ui).
KELTA_VERSION=0.1.0

# ─────────────────────────────────────────────
# Authentication — kelta-auth
# ─────────────────────────────────────────────

# RSA JWK Set for JWT signing. Generated by `make gen-keys`.
# Format: single-line JSON {"keys":[{...RS256 private key...}]}
JWK_SET=

# AES-256 master key for envelope encryption (Base64-encoded 32 bytes).
# Generated by `make gen-keys` via: openssl rand -base64 32
KELTA_ENCRYPTION_KEY=

# Shared secret for internal service-to-service calls
KELTA_INTERNAL_TOKEN=dev-internal-token

# Initial password for the platform admin (admin@kelta.local), applied on the first boot
# and changed by you at first sign-in. Leave empty and kelta-auth generates one and prints
# it once: docker compose logs kelta-auth | grep -o 'Password: *[A-Za-z0-9]*'
KELTA_BOOTSTRAP_ADMIN_PASSWORD=

# ─────────────────────────────────────────────
# HMAC signing keys — kelta-worker
# ─────────────────────────────────────────────
# No defaults: the worker refuses to start without these. They previously fell back to
# hardcoded values, which is how production ended up signing real links with keys published
# in this repo. `make gen-keys` writes a random value for each; `make up` supplies local-only
# literals via docker-compose, so these matter for a bare `mvn spring-boot:run`.

# Signs emailed telehealth visit links. A visit token is exchangeable for a portal login.
KELTA_TELEHEALTH_VISIT_SECRET=
# Signs the Reply-To thread token on support-mailbox replies. The worker refuses to start
# without it: an unsigned token is a forgeable one, and forging it posts into a conversation.
KELTA_MAILBOX_VERP_SECRET=

# Signs campaign open-pixel, click-redirect and unsubscribe links. Rotating this invalidates
# links in already-delivered email, which never expire.
CAMPAIGN_TRACKING_SECRET=

# ─────────────────────────────────────────────
# AI service — kelta-ai (only needed with --profile ai)
# ─────────────────────────────────────────────

ANTHROPIC_API_KEY=

# Optional: override default Claude model
# AI_DEFAULT_MODEL=claude-sonnet-4-20250514

# ─────────────────────────────────────────────
# Public-traffic hardening (optional)
# ─────────────────────────────────────────────

# Fraction of a tenant's rate-limit window one member may consume (gateway).
# Stops a single member — or a stolen PAT — consuming the WHOLE tenant window.
# Close to 1 on purpose: one admin or integration PAT is legitimately most of a
# tenant. Tighten it for tenants with many members. 1.0 disables the window.
# RATE_LIMIT_USER_SHARE=0.9

# Per-IP budgets for kelta-auth's public portal paths, <prefix>=<per-minute>.
# KELTA_AUTH_RATE_LIMIT_IP_PATHS=/portal/api/signup=5,/portal/api/login/request=10,/portal/api/challenge=30,/portal/login=10
# How many X-Forwarded-For hops to count back from the RIGHT to find the client.
# The leftmost entry is client-supplied and is never trusted. 0 = ignore the header.
# KELTA_AUTH_RATE_LIMIT_TRUSTED_PROXY_COUNT=1
# Trusted proxy CIDRs for client-IP resolution (gateway + auth); empty = legacy behaviour
# KELTA_SECURITY_TRUSTED_PROXIES=10.42.0.0/16

# Proof-of-work bot challenge on portal signup + magic-link request (default off).
# The HMAC key must be the SAME on every auth pod — enabling without one fails
# startup deliberately, because a per-pod key rejects real users at random.
# Generate with: openssl rand -base64 32
# KELTA_AUTH_BOT_CHALLENGE_ENABLED=false
# KELTA_AUTH_BOT_CHALLENGE_HMAC_KEY=
# Raise max-number to make solving cost more (too high hurts phones).
# KELTA_AUTH_BOT_CHALLENGE_MAX_NUMBER=100000
# KELTA_AUTH_BOT_CHALLENGE_TTL_SECONDS=600

# ─────────────────────────────────────────────
# Browser Web Push — kelta-worker (optional)
# ─────────────────────────────────────────────

# VAPID application-server keys (RFC 8292). Generate with `make gen-vapid`.
# Public key: base64url uncompressed P-256 point (what a browser passes to
# pushManager.subscribe). Private key: its raw base64url scalar.
# Leave empty to run without browser push — native push is unaffected.
# Rotating these invalidates every existing browser subscription.
# KELTA_PUSH_VAPID_PUBLIC_KEY=
# KELTA_PUSH_VAPID_PRIVATE_KEY=
# Must be a mailto: or https: URI — Safari rejects anything else.
# KELTA_PUSH_VAPID_SUBJECT=mailto:admin@localhost

# ─────────────────────────────────────────────
# IP geolocation — kelta-gateway (optional)
# ─────────────────────────────────────────────

# Free license key from a MaxMind account (https://www.maxmind.com/en/geolite2/signup).
# Enables automatic GeoLite2-City downloads; leave empty to run without geo enrichment.
# MAXMIND_LICENSE_KEY=

# ─────────────────────────────────────────────
# Logging overrides (optional)
# ─────────────────────────────────────────────

# LOG_LEVEL=INFO
# SECURITY_LOG_LEVEL=WARN
