{
  "name": "@kelta/sdk",
  "version": "0.0.1",
  "description": "Type-safe TypeScript client for Kelta APIs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "kelta-generate-types": "./dist/cli/generate-types.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli/index.js",
      "require": "./dist/cli/index.cjs",
      "types": "./dist/cli/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "generate-types": "node --loader ts-node/esm src/cli/generate-types.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "axios": "^1.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "axios": "^1.21.0",
    "zod": "^4.6.7"
  },
  "keywords": [
    "kelta",
    "sdk",
    "typescript",
    "api-client",
    "rest-client",
    "openapi",
    "type-generation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kelta/kelta-web.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/kelta/kelta-web/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/kelta/kelta-web/issues"
  },
  "author": "Kelta Team",
  "engines": {
    "node": ">=18.0.0"
  },
  "sideEffects": false
}
