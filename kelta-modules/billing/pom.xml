<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      DELIBERATELY NOT part of the kelta-platform reactor, and with no parent pom.

      This is a runtime-installable module: it is built, signed, and versioned independently of
      the platform, then uploaded into a tenant through POST /api/modules/install-jar. Wiring it
      into the reactor would make it ship with the platform and quietly undo the point of the
      exercise — proving a customer can extend Kelta with no platform recompile or redeploy.

      Build:  mvn -f kelta-modules/billing/pom.xml package
      Output: target/kelta-module-billing-<version>.jar  (upload with kelta-module.json)
    -->
    <groupId>io.kelta.modules</groupId>
    <artifactId>kelta-module-billing</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Kelta Billing Module</name>
    <description>Stripe-backed portal billing as a runtime-installable Kelta module</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <kelta.platform.version>1.0.0-SNAPSHOT</kelta.platform.version>
    </properties>

    <dependencies>
        <!--
          `provided`, not `compile`: every one of these is loaded from the PLATFORM classloader at
          runtime (they sit under SandboxedModuleClassLoader's allowed parent prefixes). Bundling
          them would put a second copy of the runtime model in the JAR, and the module's classes
          would then fail to cast to the platform's.
        -->
        <dependency>
            <groupId>io.kelta</groupId>
            <artifactId>runtime-core</artifactId>
            <version>${kelta.platform.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.kelta</groupId>
            <artifactId>runtime-module-integration</artifactId>
            <version>${kelta.platform.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <!-- Packages kelta-module.json and the UI bundle alongside the classes, so the
                     whole module is one uploadable artifact. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
            </plugin>
        </plugins>
    </build>
</project>
