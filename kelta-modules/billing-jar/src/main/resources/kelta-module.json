{
  "id": "kelta-billing",
  "name": "Kelta Billing",
  "version": "1.0.0",
  "description": "Stripe-backed portal billing: plans, checkout, subscriptions and one-time passes.",
  "author": "Kelta",
  "moduleClass": "io.kelta.modules.billing.BillingModule",
  "minPlatformVersion": "1.0.0",
  "permissions": [
    "MANAGE_BILLING"
  ],
  "webhookHandlerKey": "billing:stripe-webhook",
  "uiBundlePath": "static/ui-bundle.js",
  "actionHandlers": [
    {
      "key": "billing:create-checkout-session",
      "name": "Start Checkout",
      "category": "Billing",
      "description": "Starts a Stripe hosted checkout for the calling member and returns the redirect URL.",
      "icon": "credit-card"
    },
    {
      "key": "billing:stripe-webhook",
      "name": "Process Stripe Webhook",
      "category": "Billing",
      "description": "Verifies and applies inbound Stripe events. Dispatched by the platform webhook route, not called directly.",
      "icon": "webhook"
    },
    {
      "key": "billing:create-portal-session",
      "name": "Open Billing Portal",
      "category": "Billing",
      "description": "Opens Stripe's billing portal for the calling member and returns the redirect URL.",
      "icon": "external-link"
    },
    {
      "key": "billing:resolve-entitlements",
      "name": "Resolve Member Entitlements",
      "category": "Billing",
      "description": "Returns the calling member's plan, subscription status and merged entitlements.",
      "icon": "shield-check"
    },
    {
      "key": "billing:expire-passes",
      "name": "Expire Due Passes",
      "category": "Billing",
      "description": "Flips due one-time passes to EXPIRED. Schedule via a scheduled flow; a tidier, not a gate.",
      "icon": "clock"
    },
    {
      "key": "billing:list-plans",
      "name": "List Plans",
      "category": "Billing",
      "description": "The tenant's purchasable plans, for a pricing page. No processor ids."
    },
    {
      "key": "billing:me",
      "name": "My Billing",
      "category": "Billing",
      "description": "The calling member's plan, subscription, live passes and entitlements."
    }
  ],
  "collections": [
    {
      "name": "billing_plans",
      "displayName": "Billing Plans",
      "fields": [
        {
          "name": "code",
          "displayName": "Code",
          "type": "STRING",
          "required": true
        },
        {
          "name": "name",
          "displayName": "Name",
          "type": "STRING",
          "required": true
        },
        {
          "name": "description",
          "displayName": "Description",
          "type": "TEXT"
        },
        {
          "name": "kind",
          "displayName": "Kind",
          "type": "STRING",
          "required": true
        },
        {
          "name": "stripeProductId",
          "displayName": "Stripe Product Id",
          "type": "STRING"
        },
        {
          "name": "stripePriceId",
          "displayName": "Stripe Price Id",
          "type": "STRING"
        },
        {
          "name": "entitlements",
          "displayName": "Entitlements",
          "type": "JSON"
        },
        {
          "name": "passDurationDays",
          "displayName": "Pass Duration (days)",
          "type": "INTEGER"
        },
        {
          "name": "active",
          "displayName": "Active",
          "type": "BOOLEAN"
        },
        {
          "name": "sortOrder",
          "displayName": "Sort Order",
          "type": "INTEGER"
        }
      ]
    },
    {
      "name": "billing_customers",
      "displayName": "Billing Customers",
      "fields": [
        {
          "name": "userId",
          "displayName": "Member",
          "type": "STRING",
          "required": true
        },
        {
          "name": "stripeCustomerId",
          "displayName": "Stripe Customer Id",
          "type": "STRING",
          "required": true
        },
        {
          "name": "email",
          "displayName": "Email",
          "type": "STRING"
        }
      ]
    },
    {
      "name": "billing_subscriptions",
      "displayName": "Billing Subscriptions",
      "fields": [
        {
          "name": "userId",
          "displayName": "Member",
          "type": "STRING",
          "required": true
        },
        {
          "name": "planId",
          "displayName": "Plan",
          "type": "STRING"
        },
        {
          "name": "stripeSubscriptionId",
          "displayName": "Stripe Subscription Id",
          "type": "STRING",
          "required": true
        },
        {
          "name": "stripeCustomerId",
          "displayName": "Stripe Customer Id",
          "type": "STRING"
        },
        {
          "name": "status",
          "displayName": "Status",
          "type": "STRING",
          "required": true
        },
        {
          "name": "currentPeriodEnd",
          "displayName": "Renews On",
          "type": "DATETIME"
        },
        {
          "name": "cancelAtPeriodEnd",
          "displayName": "Cancels At Period End",
          "type": "BOOLEAN"
        },
        {
          "name": "canceledAt",
          "displayName": "Canceled At",
          "type": "DATETIME"
        }
      ]
    },
    {
      "name": "billing_passes",
      "displayName": "Billing Passes",
      "fields": [
        {
          "name": "userId",
          "displayName": "Member",
          "type": "STRING",
          "required": true
        },
        {
          "name": "planId",
          "displayName": "Plan",
          "type": "STRING"
        },
        {
          "name": "stripeCheckoutSessionId",
          "displayName": "Checkout Session Id",
          "type": "STRING",
          "required": true
        },
        {
          "name": "stripePaymentIntentId",
          "displayName": "Payment Intent Id",
          "type": "STRING"
        },
        {
          "name": "status",
          "displayName": "Status",
          "type": "STRING",
          "required": true
        },
        {
          "name": "startsAt",
          "displayName": "Starts At",
          "type": "DATETIME"
        },
        {
          "name": "expiresAt",
          "displayName": "Expires At",
          "type": "DATETIME"
        }
      ]
    },
    {
      "name": "billing_entitlement_rules",
      "displayName": "Billing Entitlement Rules",
      "fields": [
        {
          "name": "collectionName",
          "displayName": "Collection",
          "type": "STRING",
          "required": true
        },
        {
          "name": "limitKey",
          "displayName": "Limit Key",
          "type": "STRING",
          "required": true
        },
        {
          "name": "countFilter",
          "displayName": "Count Filter",
          "type": "JSON"
        },
        {
          "name": "appliesTo",
          "displayName": "Applies To",
          "type": "STRING",
          "required": true
        },
        {
          "name": "message",
          "displayName": "Message",
          "type": "STRING"
        },
        {
          "name": "active",
          "displayName": "Active",
          "type": "BOOLEAN"
        }
      ]
    }
  ],
  "services": [
    "io.kelta.runtime.module.service.EntitlementProvider"
  ],
  "routes": [
    {
      "path": "/plans",
      "methods": [
        "GET"
      ],
      "handlerKey": "billing:list-plans"
    },
    {
      "path": "/me",
      "methods": [
        "GET"
      ],
      "handlerKey": "billing:me"
    },
    {
      "path": "/checkout-sessions",
      "methods": [
        "POST"
      ],
      "handlerKey": "billing:create-checkout-session"
    },
    {
      "path": "/portal-sessions",
      "methods": [
        "POST"
      ],
      "handlerKey": "billing:create-portal-session"
    }
  ]
}
