---
import BaseLayout from '../layouts/BaseLayout.astro';

// Build-time capture destination: a Kelta collection URL whose Guest profile may create
// records (e.g. https://<tenant-host>/api/<collection>). Empty means signups are not open.
const endpoint = (import.meta.env.PUBLIC_WAITLIST_ENDPOINT ?? '').trim();
const RELEASES_URL = 'https://github.com/kelta-io/kelta/releases';
---

<BaseLayout title="Waitlist" description="Get early access to Kelta Cloud, a fully managed, hosted version of the Kelta enterprise application platform.">
  <section class="bg-gradient-to-b from-kelta-50 to-white py-20">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h1 class="text-4xl font-extrabold text-navy md:text-5xl">Get early access to Kelta Cloud</h1>
      <p class="mt-6 text-lg leading-relaxed text-kelta-700">
        Kelta is open source and self-hostable today —
        <a href="https://github.com/kelta-io/kelta" class="font-semibold text-cyan hover:text-blue" target="_blank" rel="noopener noreferrer">clone the repo</a>
        and run it on your own infrastructure right now. We're also building a fully managed,
        hosted version of the platform.
      </p>

      {endpoint ? (
        <>
          <p class="mt-4 text-lg leading-relaxed text-kelta-700">
            Leave your email and we'll reach out when early access opens.
          </p>
          <form id="waitlist-form" class="mx-auto mt-10 flex max-w-md flex-col gap-3 sm:flex-row" novalidate>
            <label for="waitlist-email" class="sr-only">Email address</label>
            <input
              id="waitlist-email"
              name="email"
              type="email"
              required
              placeholder="Your work email"
              class="w-full flex-1 rounded-lg border border-gray-200 px-4 py-3 text-sm text-navy placeholder:text-gray-400 focus:border-cyan focus:outline-none focus:ring-2 focus:ring-cyan/30"
            />
            <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
              <label for="waitlist-website">Leave this field empty</label>
              <input id="waitlist-website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <button
              type="submit"
              class="rounded-lg bg-navy px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-kelta-800"
            >
              Join the waitlist
            </button>
          </form>
          <p id="waitlist-status" class="mt-4 min-h-[1.5rem] text-sm text-kelta-700" role="status" aria-live="polite"></p>
          <noscript>
            <p class="mt-4 text-sm text-kelta-700">
              JavaScript is required to join the waitlist. Meanwhile, watch
              <a href={RELEASES_URL} class="font-semibold text-cyan hover:text-blue">Kelta releases on GitHub</a>
              to hear when early access opens.
            </p>
          </noscript>
        </>
      ) : (
        <div id="waitlist-closed" class="mx-auto mt-10 max-w-xl rounded-lg border border-gray-200 bg-white p-6 text-left">
          <p class="text-lg font-semibold text-navy">Hosted early access is not open yet.</p>
          <p class="mt-3 text-sm leading-relaxed text-kelta-700">
            We are not collecting signups on this page yet. To hear when it opens, star or watch
            <a href="https://github.com/kelta-io/kelta" class="font-semibold text-cyan hover:text-blue" target="_blank" rel="noopener noreferrer">the GitHub repo</a>
            and choose <strong>Watch → Custom → Releases</strong> — every announcement ships as a
            <a href={RELEASES_URL} class="font-semibold text-cyan hover:text-blue" target="_blank" rel="noopener noreferrer">GitHub release</a>.
          </p>
        </div>
      )}
    </div>
  </section>

  {endpoint && (
    <script define:vars={{ endpoint }}>
      const form = document.getElementById('waitlist-form');
      const input = document.getElementById('waitlist-email');
      const honeypot = document.getElementById('waitlist-website');
      const status = document.getElementById('waitlist-status');
      const collection = new URL(endpoint, window.location.href).pathname.split('/').filter(Boolean).pop();

      const show = (message, failed) => {
        status.textContent = message;
        status.classList.toggle('text-red-600', failed);
      };
      const succeed = () => {
        show("You're on the list. We'll reach out when early access opens.", false);
        form.reset();
      };

      form?.addEventListener('submit', async (event) => {
        event.preventDefault();
        const email = input.value.trim();

        if (!email || !input.checkValidity()) {
          show('Enter a valid email address.', true);
          return;
        }
        if (honeypot.value) {
          succeed();
          return;
        }

        try {
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/vnd.api+json', Accept: 'application/vnd.api+json' },
            body: JSON.stringify({
              data: { type: collection, attributes: { email, source: 'kelta.io/waitlist' } },
            }),
          });
          if (response.ok) {
            succeed();
          } else {
            show('Something went wrong and your signup was not saved. Please try again later.', true);
          }
        } catch {
          show('Something went wrong and your signup was not saved. Please try again later.', true);
        }
      });
    </script>
  )}
</BaseLayout>
