---
/**
 * Schematic browser mockups for /console: the admin console shell and the
 * end-user app shell. Inline SVG in the brand palette, like CapabilityVisual,
 * so they ship as part of the page with no image requests.
 */
interface Props {
  kind: 'admin' | 'app';
  title: string;
}

const { kind, title } = Astro.props;

const navy = '#0F172A';
const cyan = '#06B6D4';
const blue = '#3B82F6';
const slate = '#334155';
const muted = '#94A3B8';
const line = '#E2E8F0';
const success = '#10B981';
const warning = '#F59E0B';
---

<svg
  viewBox="0 0 640 400"
  role="img"
  aria-labelledby={`mock-${kind}-title`}
  class="h-auto w-full"
  xmlns="http://www.w3.org/2000/svg"
  font-family="Inter, system-ui, sans-serif"
>
  <title id={`mock-${kind}-title`}>{title}</title>

  <!-- browser chrome -->
  <rect x="0" y="0" width="640" height="400" rx="14" fill="#fff" stroke={line} />
  <rect x="0" y="0" width="640" height="36" rx="14" fill="#F8FAFC" />
  <rect x="0" y="22" width="640" height="14" fill="#F8FAFC" />
  <line x1="0" y1="36" x2="640" y2="36" stroke={line} />
  <circle cx="20" cy="18" r="5" fill="#EF4444" /><circle cx="36" cy="18" r="5" fill={warning} /><circle cx="52" cy="18" r="5" fill={success} />
  <rect x="200" y="9" width="240" height="18" rx="9" fill="#fff" stroke={line} />
  <text x="320" y="22" fill={muted} font-size="9" text-anchor="middle" font-family="JetBrains Mono, monospace">
    {kind === 'admin' ? 'app.kelta.io/acme/collections/invoices' : 'app.kelta.io/acme/app/o/invoices'}
  </text>

  {kind === 'admin' && (
    <g>
      <!-- sidebar -->
      <rect x="0" y="36" width="150" height="364" fill={navy} />
      <text x="16" y="62" fill="#fff" font-size="10" font-weight="700">Setup</text>
      <rect x="10" y="72" width="130" height="18" rx="6" fill="#1E293B" />
      <text x="18" y="84" fill={muted} font-size="8" font-family="JetBrains Mono, monospace">⌘K  search setup…</text>
      {[
        ['Data model', ['Collections', 'Picklists', 'Page layouts', 'List views']],
        ['Security', ['Users', 'Profiles', 'Permission sets']],
        ['Automation', ['Flows', 'Approvals', 'Scheduled jobs', 'AI agents']],
        ['Experience', ['Pages', 'Menus', 'Analytics']],
        ['Platform', ['Environments', 'Monitoring', 'Governor limits']],
      ].map(([group, items], gi) => (
        <g transform={`translate(16 ${106 + gi * 56})`}>
          <text x="0" y="0" fill={muted} font-size="7" font-weight="700" letter-spacing="0.5">{String(group).toUpperCase()}</text>
          {(items as string[]).map((it, i) => (
            <text x="0" y={12 + i * 11} fill={gi === 0 && i === 0 ? cyan : '#CBD5E1'} font-size="8" font-weight={gi === 0 && i === 0 ? '600' : '400'}>{it}</text>
          ))}
        </g>
      ))}
      <!-- main: collection detail -->
      <text x="170" y="66" fill={muted} font-size="8">Collections / invoices</text>
      <text x="170" y="88" fill={navy} font-size="14" font-weight="700">invoices</text>
      <rect x="236" y="76" width="26" height="14" rx="7" fill="#ECFEFF" stroke={cyan} />
      <text x="249" y="86" fill={navy} font-size="7" text-anchor="middle" font-family="JetBrains Mono, monospace">v14</text>
      <rect x="548" y="74" width="76" height="20" rx="6" fill={cyan} />
      <text x="586" y="87" fill="#fff" font-size="8" text-anchor="middle" font-weight="600">+ Add field</text>
      <!-- tabs -->
      {['Fields', 'Layouts', 'Validation', 'Security', 'Versions'].map((t, i) => (
        <text x={170 + i * 54} y="112" fill={i === 0 ? cyan : muted} font-size="9" font-weight={i === 0 ? '600' : '400'}>{t}</text>
      ))}
      <line x1="170" y1="118" x2="624" y2="118" stroke={line} />
      <rect x="170" y="117" width="30" height="2" fill={cyan} />
      <!-- fields table -->
      <rect x="170" y="128" width="454" height="20" rx="4" fill="#F8FAFC" />
      {['Field', 'API name', 'Type', 'Required', 'Unique'].map((h, i) => (
        <text x={[180, 300, 400, 500, 560][i]} y="141" fill={muted} font-size="8" font-weight="600">{h}</text>
      ))}
      {[
        ['Customer', 'customer', 'LOOKUP', '●', ''],
        ['Amount', 'amount', 'CURRENCY', '●', ''],
        ['Due date', 'dueDate', 'DATE', '●', ''],
        ['Status', 'status', 'PICKLIST', '●', ''],
        ['Invoice no.', 'number', 'AUTO_NUMBER', '', '●'],
        ['Total', 'total', 'FORMULA', '', ''],
        ['Notes', 'notes', 'RICH_TEXT', '', ''],
      ].map(([f, api, type, req, uniq], i) => (
        <g transform={`translate(0 ${164 + i * 22})`}>
          <text x="180" y="0" fill={slate} font-size="9">{f}</text>
          <text x="300" y="0" fill={muted} font-size="8" font-family="JetBrains Mono, monospace">{api}</text>
          <rect x="398" y="-9" width={String(type).length * 5.2 + 10} height="13" rx="4" fill="#F1F5F9" />
          <text x="403" y="0" fill={slate} font-size="7" font-family="JetBrains Mono, monospace">{type}</text>
          <text x="514" y="0" fill={cyan} font-size="9" text-anchor="middle">{req}</text>
          <text x="574" y="0" fill={cyan} font-size="9" text-anchor="middle">{uniq}</text>
          <line x1="170" y1="8" x2="624" y2="8" stroke="#F1F5F9" />
        </g>
      ))}
      <!-- AI panel trigger -->
      <rect x="548" y="340" width="76" height="44" rx="10" fill={navy} />
      <text x="586" y="358" fill={cyan} font-size="8" text-anchor="middle" font-weight="600">Ask Kelta</text>
      <text x="586" y="372" fill={muted} font-size="7" text-anchor="middle">proposals · schema-aware</text>
    </g>
  )}

  {kind === 'app' && (
    <g>
      <!-- top bar -->
      <rect x="0" y="36" width="640" height="34" fill="#fff" />
      <line x1="0" y1="70" x2="640" y2="70" stroke={line} />
      <text x="16" y="57" fill={navy} font-size="11" font-weight="700">Acme CRM</text>
      {['Home', 'Invoices', 'Customers', 'Approvals', 'Reports'].map((t, i) => (
        <text x={110 + i * 62} y="57" fill={i === 1 ? cyan : slate} font-size="9" font-weight={i === 1 ? '600' : '400'}>{t}</text>
      ))}
      <rect x="440" y="44" width="120" height="18" rx="9" fill="#F8FAFC" stroke={line} />
      <text x="500" y="56" fill={muted} font-size="8" text-anchor="middle">Search  ⌘K</text>
      <!-- presence -->
      <circle cx="590" cy="53" r="8" fill={cyan} /><circle cx="602" cy="53" r="8" fill={blue} stroke="#fff" /><circle cx="614" cy="53" r="8" fill={navy} stroke="#fff" />
      <!-- list header -->
      <text x="16" y="96" fill={navy} font-size="13" font-weight="700">Overdue invoices</text>
      <text x="16" y="110" fill={muted} font-size="8" font-family="JetBrains Mono, monospace">12 records · updated 4 s ago · live</text>
      <!-- view switcher -->
      {['Table', 'Kanban', 'Gallery', 'Calendar'].map((v, i) => (
        <g>
          <rect x={372 + i * 60} y="88" width="56" height="18" rx="6" fill={i === 1 ? navy : '#fff'} stroke={i === 1 ? navy : line} />
          <text x={400 + i * 60} y="100" fill={i === 1 ? '#fff' : slate} font-size="8" text-anchor="middle" font-weight="600">{v}</text>
        </g>
      ))}
      <rect x="16" y="120" width="180" height="16" rx="5" fill="#F8FAFC" stroke={line} />
      <text x="24" y="131" fill={muted} font-size="7">status = overdue  ·  amount &gt; 1,000  ·  + filter</text>
      <!-- kanban columns -->
      {[
        ['Draft', 2, '#94A3B8'],
        ['Sent', 4, blue],
        ['Overdue', 3, warning],
        ['Paid', 5, success],
      ].map(([col, n, color], ci) => (
        <g transform={`translate(${16 + ci * 154} 150)`}>
          <rect x="0" y="0" width="142" height="234" rx="8" fill="#F8FAFC" />
          <rect x="0" y="0" width="142" height="3" rx="1.5" fill={String(color)} />
          <text x="10" y="18" fill={navy} font-size="9" font-weight="600">{col}</text>
          <text x="132" y="18" fill={muted} font-size="8" text-anchor="end">{n}</text>
          {Array.from({ length: Math.min(Number(n), 3) }).map((_, i) => (
            <g transform={`translate(8 ${28 + i * 62})`}>
              <rect x="0" y="0" width="126" height="54" rx="6" fill="#fff" stroke={line} />
              <text x="8" y="14" fill={navy} font-size="8" font-weight="600">INV-{1040 + ci * 10 + i}</text>
              <text x="8" y="27" fill={slate} font-size="7">{['Globex', 'Initech', 'Umbrella'][i]}</text>
              <text x="8" y="44" fill={navy} font-size="8" font-family="JetBrains Mono, monospace">$ {[1240, 3980, 760][i]}.00</text>
              <circle cx="112" cy="42" r="6" fill={[cyan, blue, navy][i]} />
            </g>
          ))}
        </g>
      ))}
    </g>
  )}
</svg>
