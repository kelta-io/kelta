---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
---

{headings.length > 0 && (
  <nav aria-label="On this page" data-pagefind-ignore class="text-sm">
    <h3 class="mb-2 text-xs font-semibold uppercase tracking-wider text-gray-400">On this page</h3>
    <ul id="docs-toc" class="space-y-1 border-l border-gray-200">
      {headings.map((h) => (
        <li>
          <a
            href={`#${h.slug}`}
            data-toc-slug={h.slug}
            class:list={[
              '-ml-px block border-l border-transparent py-0.5 leading-snug text-kelta-700 hover:border-cyan hover:text-navy',
              h.depth === 2 ? 'pl-3' : 'pl-6 text-xs',
            ]}
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  // Highlight the heading currently in view. Progressive enhancement only.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('#docs-toc a[data-toc-slug]'));
  if (links.length > 0 && 'IntersectionObserver' in window) {
    const bySlug = new Map(links.map((a) => [a.dataset.tocSlug!, a]));
    const setActive = (slug: string) => {
      for (const a of links) {
        const on = a.dataset.tocSlug === slug;
        a.classList.toggle('border-cyan', on);
        a.classList.toggle('text-navy', on);
        a.classList.toggle('font-medium', on);
      }
    };
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-80px 0px -70% 0px' },
    );
    for (const slug of bySlug.keys()) {
      const el = document.getElementById(slug);
      if (el) observer.observe(el);
    }
  }
</script>
