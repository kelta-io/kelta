---
import type { DocPage } from '../../docs/sidebar';

interface Props {
  prev: DocPage | null;
  next: DocPage | null;
}

const { prev, next } = Astro.props;
---

<nav aria-label="Previous and next page" data-pagefind-ignore class="mt-12 grid gap-4 border-t border-gray-200 pt-8 sm:grid-cols-2">
  <div>
    {prev && (
      <a href={prev.href} rel="prev" class="group block rounded-xl border border-gray-100 p-4 transition-colors hover:border-cyan">
        <span class="text-xs text-gray-400">&larr; Previous</span>
        <span class="mt-1 block font-medium text-navy group-hover:text-cyan">{prev.title}</span>
      </a>
    )}
  </div>
  <div>
    {next && (
      <a href={next.href} rel="next" class="group block rounded-xl border border-gray-100 p-4 text-right transition-colors hover:border-cyan">
        <span class="text-xs text-gray-400">Next &rarr;</span>
        <span class="mt-1 block font-medium text-navy group-hover:text-cyan">{next.title}</span>
      </a>
    )}
  </div>
</nav>
